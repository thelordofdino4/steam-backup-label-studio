From: Steam Backup Label Studio package codec
Subject: [PATCH] Route libjpeg-turbo decoder memory through the active operation

This is the review diff represented by
vendor/overlays/libjpeg-turbo/src/jmemnobs.c.  The compiled overlay also removes
comments and branches that are irrelevant to the decoder-only build.

--- a/src/jmemnobs.c
+++ b/src/jmemnobs.c
@@
 #include "jmemsys.h"            /* import the system-dependent declarations */
+#include "sbls_allocation_ledger.h"
@@
 jpeg_get_small(j_common_ptr cinfo, size_t sizeofobject)
 {
-  return (void *)MALLOC(sizeofobject);
+  (void)cinfo;
+  return sbls_operation_alloc(sizeofobject);
 }
@@
-  free(object);
+  (void)cinfo;
+  (void)sizeofobject;
+  sbls_operation_free(object);
@@
 jpeg_get_large(j_common_ptr cinfo, size_t sizeofobject)
 {
-  return (void *)MALLOC(sizeofobject);
+  (void)cinfo;
+  return sbls_operation_alloc(sizeofobject);
 }
@@
-  free(object);
+  (void)cinfo;
+  (void)sizeofobject;
+  sbls_operation_free(object);
@@
-  if (cinfo->mem->max_memory_to_use) {
-    if ((size_t)cinfo->mem->max_memory_to_use > already_allocated)
-      return cinfo->mem->max_memory_to_use - already_allocated;
-    else
-      return 0;
-  } else {
-    return max_bytes_needed;
-  }
+  size_t remaining = sbls_operation_remaining();
+  (void)cinfo;
+  (void)min_bytes_needed;
+  (void)already_allocated;
+  return remaining < max_bytes_needed ? remaining : max_bytes_needed;
